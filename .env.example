# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Evolution API (https://github.com/EvolutionAPI/evolution-api)
EVOLUTION_API_URL=https://your-evolution-host
EVOLUTION_API_KEY=your-global-api-key
EVOLUTION_INSTANCE_NAME=your-instance

# Redis (used by debounce + handoff queue)
REDIS_HOST=redis
REDIS_PORT=6379

# Postgres (for migrations — protected contacts, message audit)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Admin handoff (optional — phone that receives escalations)
ADMIN_PHONE=5544900000000
